# Smart Traffic Management System - Database Configuration Example
# Copy this file to 'db.properties' (which is excluded from Git) or configure environment variables:
# TRAFFIC_DB_URL, TRAFFIC_DB_USER, TRAFFIC_DB_PASSWORD

TRAFFIC_DB_URL=jdbc:mysql://localhost:3306/traffic_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
TRAFFIC_DB_USER=root
TRAFFIC_DB_PASSWORD=your_actual_mysql_password
